       #     if self.out != '__POWER_ON':
       #         raise HW_WatchdogError(error_code=HW_WatchdogError.HARD_RESET, msg="problem with Hard Reset ")
       #     self.out = ''

        self.ser.write('MODEM___ON')
        time.sleep(1)
        while self.ser.inWaiting() > 0:
            self.out += self.ser.read(1)
        if self.out != '':
            self.log_file.write('\n'+str(datetime.datetime.now().time()) +">> " + self.out)
            if self.out != 'MODEM___ON':
                raise HW_WatchdogError(error_code=HW_WatchdogError.MODEM_RESET, msg="problem with Modem Reset ")
            self.out = ''        
        self.ser.write('Gateway_On')
        time.sleep(1)
        while self.ser.inWaiting() > 0:
            self.out += self.ser.read(1)
        if self.out != '':
            self.log_file.write('\n'+str(datetime.datetime.now().time()) +">> " + self.out)
            if self.out != 'Gateway_On':
                raise HW_WatchdogError(error_code=HW_WatchdogError.GATEWAY_RESET, msg="problem with Gateway Reset ")
            self.out = ''
            
    def kick_reset(self,timeout):
        """
        Function for refreshing watchdog.
        :param: timeout = parameter for timeout delay.
        """
        self.current_date=datetime.datetime.now().date()
        if self.current_date!=self.start_date:
            file_path = log_path + "/" + str(datetime.datetime.now().date()) + ".log"
	    print "new file created" 
            unbuffered = 0
            self.log_file = open(file_path,"a",unbuffered)
            print "log_file ",self.log_file
            self.start_date=self.current_date

        #assert(timeout,int)
        # flush the serial buffer
        while self.ser.inWaiting() > 0:
            self.out += self.ser.read(1)
        self.out = ''
        
        self.ser.write('KICK_RESET')
        time.sleep(timeout)

        while self.ser.inWaiting() > 0:
            self.out += self.ser.read(1)
        if self.out != '':
            self.log_file.write('\n'+str(datetime.datetime.now().time()) +">> " + self.out)
            if self.out != 'KICK_RESET':
                raise HW_WatchdogError(error_code=HW_WatchdogError.REFRESH_HARD, msg="problem with Refresh Watchdog ")
            self.out = ''
    
    def flush_serial(self):
        """
        Function for serial flush if there is any garbage character coming from board.
        """
        output = []
        while self.ser.inWaiting() > 0:
            output += self.ser.read(1)
    
    def execute(self):
        flag = False
        while(1):
            self.ser.write('Trn_DCU_Of')
            while self.ser.inWaiting() > 0:
                self.out += self.ser.read(1)
            if self.out != '':
                print "\n>> " + self.out
                self.out = ''
            time.sleep(1)
            f = os.popen('ifconfig ppp100 | grep "inet\ addr" | cut -d: -f2 | cut -d" " -f1')
            ip=f.read()
            if ip == '':    
                self.modem_counter = self.modem_counter + 1
                flag = False
                if self.modem_counter == 10:
                    self.modem_counter = 0
                    self.ser.write('MODEM__OFF')
                    while self.ser.inWaiting() > 0:
                        self.out += self.ser.read(1)
                    if self.out != '':
                        print "\n>> " + self.out 
                        self.out = ''
                    time.sleep(9)
                    self.ser.write('MODEM___ON')
                    while self.ser.inWaiting() > 0:
                        self.out += self.ser.read(1)
                    if self.out != '':
                        print "\n>> " + self.out 
                        self.out = ''
            else:
                if flag == False:
                    print str(datetime.datetime.now())+' internet already configured with ip address '+ip
                    self.modem_counter = 0
                    flag = True
            time.sleep(1)
	    self.ser.write('Gateway_Of')
       	    time.sleep(1)
            while self.ser.inWaiting() > 0:
               self.out += self.ser.read(1)
            if self.out != '':
  	       print "\n>> "+self.out
               self.out = ''
            time.sleep(10)      
            self.ser.write('Gateway_On')
            time.sleep(1)
            while self.ser.inWaiting() > 0:
               self.out += self.ser.read(1)
            if self.out != '':
               print "\n>> "+self.out
               self.out = ''
		
            
